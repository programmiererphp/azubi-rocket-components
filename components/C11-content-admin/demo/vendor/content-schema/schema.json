{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://programmiererphp.github.io/azubi-rocket-components/services/content-schema/schema.json",
  "title": "Azubi Rocket editable portal configuration v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "content": {
      "type": "object",
      "properties": {
        "guide": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9-]{1,80}$"
                  },
                  "stage": {
                    "enum": [
                      "orientation",
                      "preparation",
                      "start"
                    ]
                  },
                  "location": {
                    "enum": [
                      "all",
                      "deutschland",
                      "ausland"
                    ]
                  },
                  "title": {
                    "$ref": "#/$defs/LocalizedFull"
                  },
                  "body": {
                    "$ref": "#/$defs/LocalizedFull"
                  }
                },
                "required": [
                  "id",
                  "stage",
                  "location",
                  "title",
                  "body"
                ],
                "additionalProperties": false
              },
              "maxItems": 200,
              "minItems": 0
            }
          },
          "required": [
            "schemaVersion",
            "items"
          ],
          "additionalProperties": false
        },
        "faq": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9-]{1,80}$"
              },
              "category": {
                "type": "string",
                "maxLength": 100
              },
              "question": {
                "$ref": "#/$defs/Localized"
              },
              "answer": {
                "$ref": "#/$defs/Localized"
              },
              "sourceUrl": {
                "type": "string",
                "pattern": "^https://",
                "maxLength": 3000
              }
            },
            "required": [
              "id",
              "category",
              "question",
              "answer"
            ],
            "additionalProperties": false
          },
          "maxItems": 2000,
          "minItems": 0
        },
        "companies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9-]{1,80}$"
              },
              "name": {
                "type": "string",
                "maxLength": 1000
              },
              "category": {
                "enum": [
                  "hotel",
                  "care",
                  "educator",
                  "sales"
                ]
              },
              "email": {
                "type": "string",
                "maxLength": 254
              },
              "emailStatus": {
                "enum": [
                  "unknown",
                  "legacy-literal",
                  "legacy-inferred",
                  "verified"
                ]
              },
              "website": {
                "type": "string",
                "maxLength": 3000
              },
              "city": {
                "type": "string",
                "maxLength": 1000
              },
              "postalCode": {
                "type": "string",
                "maxLength": 100
              },
              "address": {
                "type": "string",
                "maxLength": 1000
              },
              "phone": {
                "type": "string",
                "maxLength": 100
              }
            },
            "required": [
              "id",
              "name",
              "category",
              "email",
              "emailStatus"
            ],
            "additionalProperties": false
          },
          "maxItems": 10000,
          "minItems": 0
        },
        "quizzes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9-]{1,80}$"
              },
              "title": {
                "$ref": "#/$defs/Localized"
              },
              "intro": {
                "$ref": "#/$defs/Localized"
              },
              "questions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9-]{1,80}$"
                    },
                    "text": {
                      "$ref": "#/$defs/Localized"
                    },
                    "options": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9-]{1,80}$"
                          },
                          "text": {
                            "$ref": "#/$defs/Localized"
                          },
                          "points": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1000
                          }
                        },
                        "required": [
                          "id",
                          "text",
                          "points"
                        ],
                        "additionalProperties": false
                      },
                      "maxItems": 8,
                      "minItems": 2
                    },
                    "explanation": {
                      "$ref": "#/$defs/Localized"
                    }
                  },
                  "required": [
                    "id",
                    "text",
                    "options"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 200,
                "minItems": 1
              },
              "results": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "minRatio": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "maxRatio": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "title": {
                      "$ref": "#/$defs/Localized"
                    },
                    "body": {
                      "$ref": "#/$defs/Localized"
                    }
                  },
                  "required": [
                    "minRatio",
                    "maxRatio",
                    "title",
                    "body"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 20,
                "minItems": 1
              }
            },
            "required": [
              "id",
              "title",
              "intro",
              "questions",
              "results"
            ],
            "additionalProperties": false
          },
          "maxItems": 20,
          "minItems": 0
        },
        "resources": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "title": {
                "$ref": "#/$defs/Localized"
              },
              "intro": {
                "$ref": "#/$defs/Localized"
              },
              "cards": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9-]{1,80}$"
                    },
                    "category": {
                      "type": "string",
                      "maxLength": 100
                    },
                    "title": {
                      "$ref": "#/$defs/Localized"
                    },
                    "body": {
                      "$ref": "#/$defs/Localized"
                    },
                    "links": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "label": {
                            "$ref": "#/$defs/Localized"
                          },
                          "url": {
                            "type": "string",
                            "pattern": "^https://",
                            "maxLength": 3000
                          }
                        },
                        "required": [
                          "label",
                          "url"
                        ],
                        "additionalProperties": false
                      },
                      "maxItems": 30,
                      "minItems": 0
                    }
                  },
                  "required": [
                    "id",
                    "category",
                    "title",
                    "body",
                    "links"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 400,
                "minItems": 0
              },
              "categoryLabels": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/Localized"
                },
                "maxProperties": 100
              }
            },
            "required": [
              "title",
              "intro",
              "cards"
            ],
            "additionalProperties": false
          },
          "maxProperties": 20
        },
        "letterTemplates": {
          "type": "object",
          "properties": {
            "de": {
              "type": "object",
              "properties": {
                "subject": {
                  "type": "string",
                  "maxLength": 1000
                },
                "body": {
                  "type": "string",
                  "maxLength": 30000
                }
              },
              "required": [
                "subject",
                "body"
              ],
              "additionalProperties": false
            },
            "en": {
              "type": "object",
              "properties": {
                "subject": {
                  "type": "string",
                  "maxLength": 1000
                },
                "body": {
                  "type": "string",
                  "maxLength": 30000
                }
              },
              "required": [
                "subject",
                "body"
              ],
              "additionalProperties": false
            },
            "fr": {
              "type": "object",
              "properties": {
                "subject": {
                  "type": "string",
                  "maxLength": 1000
                },
                "body": {
                  "type": "string",
                  "maxLength": 30000
                }
              },
              "required": [
                "subject",
                "body"
              ],
              "additionalProperties": false
            },
            "ru": {
              "type": "object",
              "properties": {
                "subject": {
                  "type": "string",
                  "maxLength": 1000
                },
                "body": {
                  "type": "string",
                  "maxLength": 30000
                }
              },
              "required": [
                "subject",
                "body"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "de",
            "en",
            "fr",
            "ru"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "guide",
        "faq",
        "companies",
        "quizzes",
        "resources",
        "letterTemplates"
      ],
      "additionalProperties": false
    },
    "design": {
      "type": "object",
      "properties": {
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "surface": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "text": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "accent",
        "surface",
        "text"
      ],
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "properties": {
        "density": {
          "enum": [
            "comfortable",
            "compact"
          ]
        }
      },
      "required": [
        "density"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "content",
    "design",
    "layout"
  ],
  "additionalProperties": false,
  "$defs": {
    "Localized": {
      "type": "object",
      "required": [
        "de"
      ],
      "properties": {
        "de": {
          "type": "string",
          "maxLength": 30000,
          "minLength": 1,
          "pattern": "\\S"
        },
        "en": {
          "type": "string",
          "maxLength": 30000
        },
        "fr": {
          "type": "string",
          "maxLength": 30000
        },
        "ru": {
          "type": "string",
          "maxLength": 30000
        }
      },
      "additionalProperties": false
    },
    "LocalizedFull": {
      "type": "object",
      "required": [
        "de",
        "en",
        "fr",
        "ru"
      ],
      "properties": {
        "de": {
          "type": "string",
          "maxLength": 30000,
          "minLength": 1,
          "pattern": "\\S"
        },
        "en": {
          "type": "string",
          "maxLength": 30000
        },
        "fr": {
          "type": "string",
          "maxLength": 30000
        },
        "ru": {
          "type": "string",
          "maxLength": 30000
        }
      },
      "additionalProperties": false
    }
  }
}
