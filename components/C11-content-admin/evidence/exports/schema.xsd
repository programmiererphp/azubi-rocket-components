<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
 <xs:annotation><xs:documentation>Azubi Rocket configuration v1. The JSON text in each section MUST additionally validate against schema.json. Content keys: guide,faq,companies,quizzes,resources,letterTemplates. Plain text only, no DTD or entities. Root azr-site is a complete snapshot; azr-block merges one area or one content key into the current snapshot before full validation.</xs:documentation></xs:annotation>
 <xs:element name="azr-site"><xs:complexType><xs:sequence><xs:element name="content" type="xs:string"/><xs:element name="design" type="xs:string"/><xs:element name="layout" type="xs:string"/></xs:sequence><xs:attribute name="schemaVersion" type="xs:positiveInteger" use="required" fixed="1"/></xs:complexType></xs:element>
 <xs:element name="azr-block"><xs:complexType mixed="true"><xs:attribute name="schemaVersion" type="xs:positiveInteger" use="required" fixed="1"/><xs:attribute name="area" use="required"><xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="content"/><xs:enumeration value="design"/><xs:enumeration value="layout"/></xs:restriction></xs:simpleType></xs:attribute><xs:attribute name="key"><xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="guide"/><xs:enumeration value="faq"/><xs:enumeration value="companies"/><xs:enumeration value="quizzes"/><xs:enumeration value="resources"/><xs:enumeration value="letterTemplates"/></xs:restriction></xs:simpleType></xs:attribute></xs:complexType></xs:element>
</xs:schema>
