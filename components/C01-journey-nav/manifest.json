{
  "schema_version": "1.0",
  "component_id": "C01",
  "custom_element": "azr-journey-nav",
  "version": "0.1.0",
  "public_github_repo": "programmiererphp/azubi-rocket-components",
  "public_anonymous_fetch_verified": true,
  "entrypoints": {
    "esm": "dist/index.js",
    "sha256": "a54fdf23ee3ad772567c35da5a6478c3bb4063fbe75bc19bce6dddb574120d1c"
  },
  "input_attributes": [
    {
      "name": "current-step",
      "values": "1..6",
      "default": "1"
    },
    {
      "name": "language",
      "values": [
        "de",
        "en",
        "fr",
        "ru"
      ],
      "default": "de"
    },
    {
      "name": "busy",
      "type": "boolean attribute; presence means true"
    }
  ],
  "input_properties": [
    {
      "name": "state",
      "schema": {
        "type": "object",
        "required": [
          "currentStep",
          "completedSteps",
          "availableSteps"
        ],
        "properties": {
          "currentStep": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "completedSteps": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            }
          },
          "availableSteps": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            }
          }
        }
      },
      "invariants": [
        "currentStep must be available",
        "invalid values throw TypeError and retain prior state",
        "arrays are defensively copied"
      ]
    },
    {
      "name": "language",
      "enum": [
        "de",
        "en",
        "fr",
        "ru"
      ]
    },
    {
      "name": "busy",
      "type": "boolean"
    }
  ],
  "emitted_events": [
    {
      "name": "azr:navigate",
      "bubbles": true,
      "composed": true,
      "detail_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "fromStep",
          "toStep",
          "via"
        ],
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "fromStep": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "toStep": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "via": {
            "enum": [
              "step",
              "keyboard",
              "previous",
              "next"
            ]
          }
        }
      }
    },
    {
      "name": "azr:navigation-error",
      "bubbles": true,
      "composed": true,
      "detail_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "code",
          "attribute"
        ],
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "code": {
            "const": "invalid-attribute"
          },
          "attribute": {
            "enum": [
              "current-step",
              "language"
            ]
          }
        }
      }
    }
  ],
  "dependencies": [],
  "services": [],
  "storage": "none",
  "css_custom_properties": [
    "--azr-text",
    "--azr-font",
    "--azr-border",
    "--azr-surface",
    "--azr-accent"
  ],
  "parts": [
    "navigation"
  ],
  "locales": [
    "de",
    "en",
    "fr",
    "ru"
  ],
  "responsive": {
    "desktop": "6 columns",
    "mobile_max_width": 640,
    "mobile": "2 rows of 3 labelled steps"
  },
  "tests": "tests/browser.mjs",
  "runtime_budget": {
    "network_calls": 0,
    "ai_calls": 0,
    "esm_max_bytes": 24000
  },
  "visual_reference": "AZR-MASTER-FLOW-03",
  "license": "See root RIGHTS.md",
  "git_commit_sha": "2711a326df4e089d789b7b864c4c28e33181b46e"
}
